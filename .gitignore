# ==========================================
# DiscFinanci - Arquivos Ignorados pelo Git
# ==========================================

# 1. Ambientes Virtuais Python
venv/
.venv/
env/
ENV/
backend/venv/

# 2. Cache e Byte-code do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 3. Dependências e Builds do Frontend (Node.js)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Variáveis de Ambiente e Segredos (NUNCA SUBIR PRO GIT)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.env

# 5. Logs e Arquivos Temporários
logs/
*.log
scratch/

# 6. Atalhos e Arquivos de Sistema
*.lnk
.DS_Store
Thumbs.db
.vscode/
.idea/
