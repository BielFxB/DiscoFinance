# DiscFinanci - Exemplo de Variáveis de Ambiente
# Preencha com os valores reais no servidor no arquivo backend/.env

PORT=8001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Segredos JWT
JWT_SECRET=coloque-aqui-uma-chave-secreta-longa-e-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Supabase (Banco de Dados PostgreSQL)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Bot do Discord
DISCORD_BOT_TOKEN=seu-token-do-bot-do-discord-aqui
